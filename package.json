    "refresh:maxmind": "tsx scripts/refresh_maxmind_db.ts",
    "test:forensics": "tsx scripts/test_forensics.ts",
    "test:intelligence": "tsx scripts/test_intelligence.ts",
    "test:network": "tsx scripts/test_network_intelligence.ts",
    "test": "tsx scripts/test_forensics.ts && tsx scripts/test_intelligence.ts && tsx scripts/test_network_intelligence.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.114.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@xenova/transformers": "^2.17.2",
    "@xyflow/react": "^12.11.5",
    "axios": "^1.20.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "groq": "^6.11.0",
    "html2canvas": "^1.4.1",
    "http-proxy-middleware": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "mailauth": "^5.0.2",
    "maxmind": "^5.0.7",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "node-html-parser": "^9.0.3",
    "pdfkit": "^0.20.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
