  "name": "tracexmail",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "setup:maxmind": "tsx scripts/download_maxmind_db.ts",
    "refresh:maxmind": "tsx scripts/refresh_maxmind_db.ts",
    "test:forensics": "tsx scripts/test_forensics.ts",
    "test:intelligence": "tsx scripts/test_intelligence.ts",
    "test:network": "tsx scripts/test_network_intelligence.ts",
    "worker": "tsx src/worker.ts",
    "test:unit": "vitest run",
    "test": "vitest run && tsx scripts/test_forensics.ts && tsx scripts/test_intelligence.ts && tsx scripts/test_network_intelligence.ts",
    "lint": "tsc --noEmit",
    "model:list": "tsx scripts/ml/model_registry.ts list",
    "model:promote": "tsx scripts/ml/model_registry.ts promote",
    "model:rollback": "tsx scripts/ml/model_registry.ts rollback",
    "model:drift": "tsx scripts/ml/model_registry.ts drift",
    "data:build": "tsx scripts/ml/build_eval_dataset.ts",
    "ml:benchmark": "tsx scripts/ml/benchmark.ts",
    "ml:ablation": "tsx scripts/ml/ablation.ts --offline",
    "ml:llm-eval": "tsx scripts/ml/eval_llm.ts",
    "ml:finetune-smoke": "tsx scripts/ml/finetune_transformer.ts",
    "ml:errors": "tsx scripts/ml/error_analysis.ts",
    "report:all": "tsx scripts/ml/benchmark.ts && tsx scripts/ml/ablation.ts --offline && tsx scripts/ml/eval_llm.ts && tsx scripts/ml/finetune_transformer.ts && tsx scripts/ml/error_analysis.ts"
  },
